{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "node": "20.18.0",
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "REACT_NATIVE_ARCHITECTURES": "arm64-v8a"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.18.0"
    }
  },
  "submit": {
    "production": {}
  }
}
